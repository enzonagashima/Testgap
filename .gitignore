# ==========================================
# TestGap — .gitignore
# ==========================================

# ------------------------------------------
# 1. Ambientes Virtuais (Virtual Environments)
# ------------------------------------------
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# 2. Caches do Python e Bytecode
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# 3. Banco de Dados Local & Arquivos SQLite
# (Nunca versionar o banco de dados nem logs WAL)
# ------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.db-wal
data/*.db-shm

# ------------------------------------------
# 4. Backups e Exportações Geradas
# (Podem conter código ou dados proprietários)
# ------------------------------------------
data/backups/*
!data/backups/.gitkeep

data/exports/*
!data/exports/.gitkeep

data/examples/*
!data/examples/.gitkeep

# Arquivos temporários de importação/exportação
temp_*
*.jsonl.tmp

# ------------------------------------------
# 5. Segredos e Variáveis de Ambiente
# ------------------------------------------
.env
.env.example
.env.local
.env.*.local
*.pem
*.key

# ------------------------------------------
# 6. Streamlit — Credenciais e Segredos
# (Manter config.toml para parâmetros do servidor)
# ------------------------------------------
.streamlit/credentials.toml
.streamlit/secrets.toml

# ------------------------------------------
# 7. Testes, Cobertura e Linters
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# ------------------------------------------
# 8. IDEs e Editores de Código
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# 9. Arquivos do Sistema Operacional
# ------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
